# =====================================================================
# AutoYout .gitignore
# =====================================================================

# ── Byte-compiled / optimized / runtime files ──────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Distribution / packaging / builds ──────────────────────────────
build/
dist/
*.egg-info/
*.egg
*.manifest
*.spec.bak

# ── Virtual Environments ───────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Testing & Code Quality ─────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ── IDEs, Editors & OS Files ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Local Secrets, User Configuration & Credentials ────────────────
config/user_settings.json
config/language_prompt.json
config/youtube_credentials/
*.env
.env.*

# ── Runtime Output, Caches & Logs ──────────────────────────────────
logs/
*.log
preview/
tmp/
*.tmp
*.bak

# ── Heavy Local Binaries & Voice Model Packs (downloaded on demand) ─
bin/
H2MTTS/
PiperTTS/
F5TTS/
XTTS/
XTTSv2/
tts/
*.safetensors
*.pth
*.onnx
*.pt
*.ckpt
*.gguf

# ── AI Agents / Assistant scratch directories ──────────────────────
.agents/
.impeccable/

# ── Legacy / Node.js artifacts ─────────────────────────────────────
package.json
package-lock.json
node_modules/
